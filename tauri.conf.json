{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "steambro",
  "version": "0.0.1",
  "identifier": "io.github.shalamowww.steambro",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "steambro",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#0f1218"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://art.localhost; style-src 'self' 'unsafe-inline'; connect-src http://ipc.localhost"
    }
  },
  "bundle": { "icon": ["icons/icon.ico", "icons/icon.png"] }
}
